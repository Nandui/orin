# Copy to .env.local and fill in. Every value is OPTIONAL for local dev:
# with nothing set, SPAWN serves seeded mock stories so the feed still renders.

# --- Supabase (Postgres + Auth + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI analysis provider (overviews / analysis / sentiment) ---
# Set ONE of these. DeepSeek is used when DEEPSEEK_API_KEY is present,
# otherwise Anthropic Claude.
DEEPSEEK_API_KEY=
# Optional overrides: DEEPSEEK_MODEL (default deepseek-chat),
# DEEPSEEK_BASE_URL (default https://api.deepseek.com)
ANTHROPIC_API_KEY=

# --- Upstash Redis (hot view counts) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (Pro subscription) — Phase 2/3 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=

# --- Cron auth: random string, sent as `Bearer <CRON_SECRET>` by Vercel Cron.
# If unset, cron routes run unauthenticated (dev only).
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
